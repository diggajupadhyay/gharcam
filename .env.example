# gharcam configuration — copy to .env and edit:
#   cp .env.example .env
# Docker Compose reads .env automatically.

# --- Recording ---
# Length of each recorded file segment (MediaMTX fMP4).
# Examples: 15m, 30m, 1h, 6h
RECORD_SEGMENT_DURATION=1h

# Auto-delete recordings older than this many hours (used by prune-recordings.sh).
RETENTION_HOURS=72

# --- Capture / camera ---
# V4L2 device node (ls /dev/video* to discover)
CAM_DEVICE=/dev/video0
# Capture format: mjpeg (best for most webcams) or auto (camera default)
CAM_FORMAT=mjpeg
# Resolution and frame rate — lower if CPU is high or camera lacks this mode
CAM_SIZE=1280x720
CAM_FPS=12
CAM_BITRATE=1600k
CAM_PRESET=superfast

# --- Overlay ---
OVERLAY_ENABLE=on
OVERLAY_TEXT=gharcam
# Burned-in clock timezone (both services should match)
TZ=UTC
